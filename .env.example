# LifeScan — environment template.
# Copy to .env.local and fill in. NEVER commit the filled-in file.

# ---------- Phase 1: chain ----------
# Private key of the deployer wallet (Base Sepolia testnet ONLY — never a real-funds key)
DEPLOYER_PRIVATE_KEY=
# Base Sepolia RPC. The public endpoint works; a free Alchemy/Infura key is more reliable.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# For contract source verification on Basescan (free account -> API key)
BASESCAN_API_KEY=

# Populated automatically by the deploy script
NEXT_PUBLIC_PROVIDER_REGISTRY_ADDRESS=
NEXT_PUBLIC_ACCESS_LOG_ADDRESS=
NEXT_PUBLIC_AGENT_LOG_ADDRESS=

# ---------- Phase 2: wallets ----------
# Privy app ID — email login -> embedded wallet, no seed phrases
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------- Phase 2: guardians ----------
# Each guardian runs as a separate process with its own share and ID
GUARDIAN_1_URL=http://localhost:4001
GUARDIAN_2_URL=http://localhost:4002
GUARDIAN_3_URL=http://localhost:4003

# Combined guardian endpoints (comma-separated, used by the web app)
NEXT_PUBLIC_GUARDIAN_URLS=http://localhost:4001,http://localhost:4002,http://localhost:4003

# ---------- Phase 3: AI agent ----------
OPENAI_API_KEY=

# Agent model — swap to gpt-5.4-mini or gpt-5.4-nano to cut cost
OPENAI_MODEL=gpt-5.6-luna

# Agent reasoning effort — low | medium | high
OPENAI_REASONING_EFFORT=low

# Agent wallet (server-side; the AI agent's own on-chain identity)
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Agent service endpoint (local dev)
NEXT_PUBLIC_AGENT_URL=http://localhost:4100

# ---------- Phase 4: alerts ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_TO_NUMBER=

# Contract addresses (populated by deploy script or set manually)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=84532

# ---------- Phase 5: admin console ----------
# Shared secret that gates provider registration writes at /admin. The deployer
# key signs server-side; a caller must present this token in x-admin-token.
# Leave blank to keep the registry read-only.
ADMIN_TOKEN=

# ---------- Card PIN lock: reset-code email (Resend) ----------
# Optional. Used only to email the one-time code when a card owner resets a
# forgotten PIN. Leave RESEND_API_KEY blank and the reset code is logged to the
# server console instead (the whole flow still works for local/dev testing).
# Get a key at resend.com. The default from-address (onboarding@resend.dev) only
# delivers to your own Resend account email — verify a domain to email anyone.
RESEND_API_KEY=
RESEND_FROM=LifeScan <onboarding@resend.dev>

# ---------- Upstash Redis ----------
# Optional. Used for rate-limiting and caching. If unset, falls back to local .data files.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate-limit / faucet-cap overrides (sensible defaults if unset):
#   RL_FAUCET_DAY_CAP   max distinct wallets the faucet funds per day (default 50)
#   RL_<BUCKET>_LIMIT / RL_<BUCKET>_WINDOW   per-route limits (see lib/rate-limit.ts)
